# Copy this file to .env and adjust values before running `docker compose up -d`.
# This single .env drives the backend, frontend, and landing containers.

# --- Application ---
APP_NAME=Sprint Retro
APP_ENV=production

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Public URL the frontend uses to call the backend from the browser.
FRONTEND_URL=http://localhost:3000

DATABASE_URL=sqlite:///./data/sprint_retro.db

# Generate a strong random value, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Frontend ---
# Base URL the browser uses to reach the backend. Baked in at image build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Landing page (separate container, marketing site) ---
LANDING_PORT=3001
# Public URL of the app itself, used by the landing page's Login/CTA buttons. Baked in at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
